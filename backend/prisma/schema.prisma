// /backend/prisma/schema.prisma
// Naracol Estudio: catálogo de diseño e impresión 3D con pedidos por WhatsApp.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuarios del panel administrativo
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  role           String    @default("ADMIN")
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
}

// Diapositivas del carrusel del home
model Banner {
  id           String    @id @default(uuid())
  title        String
  subtitle     String?
  imageDesktop String // URL pública en GCS (WebP)
  imageMobile  String? // Opcional: si falta se usa imageDesktop
  ctaLabel     String? // Texto del botón
  ctaUrl       String? // Ruta interna (/seccion/clickers) o URL externa
  sortOrder    Int       @default(0)
  active       Boolean   @default(true)
  startsAt     DateTime? // Si existe, no se muestra antes de esta fecha
  endsAt       DateTime? // Si existe, no se muestra después de esta fecha
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active, sortOrder])
}

// Biblioteca de colores de filamento. Son datos de producto, NO colores de marca.
model Color {
  id        String         @id @default(uuid())
  name      String         @unique // "Verde rana", "Rojo navidad"…
  hex       String // "#3FA34D"
  available Boolean        @default(true) // false = agotado: desaparece de todas las paletas
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  sections  SectionColor[]
  products  ProductColor[]
}

// Secciones del sitio: Clickers, Temporada, Hogar…
model Section {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  tag         String? // Etiqueta corta, p. ej. "NAVIDAD" en Temporada
  description String         @default("")
  coverImage  String? // Imagen del overview (GCS)
  sortOrder   Int            @default(0)
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  products    Product[]
  colors      SectionColor[] // Paleta de la sección (editable en el admin)
}

model SectionColor {
  sectionId String
  colorId   String
  sortOrder Int     @default(0)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([sectionId, colorId])
}

model Product {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String         @default("")
  sectionId   String?
  section     Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  images      String[] // URLs públicas en GCS (WebP); la primera es la portada
  price       Int? // Pesos colombianos. null = "a cotizar"
  featured    Boolean        @default(false)
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  colors      ProductColor[] // Colores en los que se puede pedir

  @@index([sectionId, active, sortOrder])
}

model ProductColor {
  productId String
  colorId   String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([productId, colorId])
}

// Ajustes editables: WhatsApp, mensaje por defecto, redes
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
