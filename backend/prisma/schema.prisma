// /backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  APPROVED
  SHIPPED
  CANCELLED
  REFUNDED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  role          String   @default("ADMIN") // Para panel administrativo
  failedAttempts Int     @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
}

model Product {
  id              String             @id @default(uuid())
  name            String
  description     String
  slug            String             @unique
  basePrice       Decimal            @db.Decimal(10, 2) // Precio de venta
  costPrice       Decimal            @db.Decimal(10, 2) // Precio de lote/maquila para margen
  category        Category           @relation(fields: [categoryId], references: [id])
  categoryId      String
  images          String[]           // URLs públicas en Google Cloud Storage (WebP)
  stockPhysical   Int                // Total de todas las tallas (se mantiene igual a la suma de variants)
  stockAvailable  Int                // Total disponible de todas las tallas (suma de variants)
  variants        ProductVariant[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  orderItems      OrderItem[]
  reservations    StockReservation[]
}

// Talla de un producto con su propio inventario. "Única" = talla única.
model ProductVariant {
  id             String             @id @default(uuid())
  productId      String
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           String             // "S", "M", "10", "Única"…
  sortOrder      Int                @default(0)
  stockPhysical  Int                @default(0) // Inventario real en bodega
  stockAvailable Int                @default(0) // Inventario menos reservas activas
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  reservations   StockReservation[]
  orderItems     OrderItem[]

  @@unique([productId, size])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Checkout {
  id              String             @id @default(uuid())
  externalId      String             @unique // Referencia de pago enviada a Wompi
  amountInCents   Int                // Monto firmado en Wompi (COP x 100)
  customerEmail   String
  customerName    String
  shippingAddress Json
  // Autorización de tratamiento de datos (Ley 1581 de 2012): cuándo y qué versión aceptó
  privacyAcceptedAt DateTime?
  policyVersion     String?
  expiresAt       DateTime           // TTL de 15 minutos
  createdAt       DateTime           @default(now())
  reservations    StockReservation[]

  @@index([expiresAt])
}

model StockReservation {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  checkoutId String
  checkout   Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
}

model Order {
  id               String      @id @default(uuid())
  customerEmail    String
  customerName     String
  status           OrderStatus @default(PENDING)
  totalAmount      Decimal     @db.Decimal(10, 2)
  paymentId        String?     @unique // ID de la transacción en Wompi
  trackingNumber   String?     // Guía de envío física
  shippingAddress  Json        // Datos de dirección
  privacyAcceptedAt DateTime?  // Autorización de tratamiento de datos (Ley 1581)
  policyVersion     String?    // Versión de términos/política aceptada
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  items            OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  size      String?  // Talla comprada (se guarda el texto por si la talla se elimina después)
  quantity  Int
  priceAtPurchase Decimal @db.Decimal(10, 2)
}