PORT=3000

# PostgreSQL — desarrollo local (TCP directo)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/nara_db"

# Producción (Cloud Run + Cloud SQL): la conexión NO es por TCP/localhost,
# es por socket Unix a través del sidecar de Cloud SQL que monta
# --add-cloudsql-instances. El secreto "nara-database-url" en Secret Manager
# debe tener este formato (sin puerto, con ?host=/cloudsql/...):
#   postgresql://USUARIO:PASSWORD@localhost/nara_db?host=/cloudsql/PROYECTO:REGION:INSTANCIA
# _CLOUD_SQL_INSTANCE en cloudbuild.yaml debe coincidir con "PROYECTO:REGION:INSTANCIA".

# Secreto para tokens del panel admin (mín. 32 caracteres en producción)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# Secreto compartido para el endpoint interno de limpieza de reservas TTL
# (POST /api/v1/internal/cron/release-expired-stock), llamado por Cloud
# Scheduler en producción vía header X-Cron-Secret. Mín. 32 caracteres.
CRON_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# Mercado Pago (opcional hasta activar checkout)
MP_ACCESS_TOKEN=tu_access_token_aqui

# Brevo (opcional hasta activar emails)
BREVO_API_KEY=tu_api_key_aqui

# URLs locales
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
BACKEND_URL=http://localhost:3000

# Credenciales del admin inicial (solo para npm run db:seed)
SEED_ADMIN_EMAIL=admin@nara.com
SEED_ADMIN_PASSWORD=admin123
